#!/usr/bin/env python3
"""Root-only NetworkManager helper for the single-radio setup and recovery AP."""
import json
import os
import secrets
import subprocess
import sys
import time
import uuid
from pathlib import Path

IFACE = "wlan0"
AP_NAME = "viju-setup"
SECRET_FILE = Path("/etc/viju-ticketbooth/access.env")
NM_DIR = Path("/etc/NetworkManager/system-connections")
SSID = "ViJu-TicketBooth-Setup"


def nm(*args, timeout=40, check=True):
    result = subprocess.run(["nmcli", *args], capture_output=True, text=True, timeout=timeout, check=False)
    if check and result.returncode:
        raise RuntimeError(result.stderr.strip() or "NetworkManager command failed")
    return result


def active():
    return nm("-g", "GENERAL.CONNECTION", "device", "show", IFACE, check=False).stdout.strip()


def status():
    con = active()
    ip = nm("-g", "IP4.ADDRESS", "device", "show", IFACE, check=False).stdout.strip().splitlines()
    ssid = nm("-g", "802-11-wireless.ssid", "connection", "show", con, check=False).stdout.strip() if con not in ("", "--", AP_NAME) else None
    return {"mode": "setup-ap" if con == AP_NAME else ("client" if con and con != "--" else "disconnected"), "interface": IFACE,
            "connected": bool(con and con not in ("--", AP_NAME)), "ssid": ssid,
            "ip_address": ip[0].split("/")[0] if ip else None, "setup_ap_active": con == AP_NAME,
            "setup_ap_ssid": SSID if con == AP_NAME else None, "recovery_mode": con == AP_NAME}


def secret():
    values = {}
    for line in SECRET_FILE.read_text().splitlines():
        key, _, value = line.partition("=")
        values[key] = value
    password = values.get("SETUP_AP_PASSWORD", "")
    if not 8 <= len(password) <= 63:
        raise RuntimeError("SETUP_AP_PASSWORD missing")
    return password


def ap():
    if active() == AP_NAME:
        return
    path = NM_DIR / "viju-setup.nmconnection"
    if not path.exists():
        content = f"""[connection]
id={AP_NAME}
uuid={uuid.uuid4()}
type=wifi
interface-name={IFACE}
autoconnect=false

[wifi]
mode=ap
ssid={SSID}
band=bg
channel=6

[wifi-security]
key-mgmt=wpa-psk
psk={secret()}

[ipv4]
method=shared
address1=192.168.4.1/24

[ipv6]
method=disabled
"""
        path.write_text(content)
        path.chmod(0o600)
        nm("connection", "load", str(path))
    nm("--wait", "30", "connection", "up", AP_NAME, "ifname", IFACE)


def connect():
    value = json.load(sys.stdin)
    ssid, password = value["ssid"], value["password"]
    if not isinstance(ssid, str) or not 1 <= len(ssid.encode()) <= 32 or any(c in ssid for c in "\r\n\x00"):
        raise ValueError("Invalid SSID")
    if not isinstance(password, str) or not 8 <= len(password) <= 63 or any(c in password for c in "\r\n\x00"):
        raise ValueError("Invalid password")
    name = "viju-home-" + secrets.token_hex(4)
    path = NM_DIR / f"{name}.nmconnection"
    path.write_text(f"""[connection]
id={name}
uuid={uuid.uuid4()}
type=wifi
interface-name={IFACE}
autoconnect=false

[wifi]
mode=infrastructure
ssid={ssid}

[wifi-security]
key-mgmt=wpa-psk
psk={password}

[ipv4]
method=auto

[ipv6]
method=auto
""")
    path.chmod(0o600)
    try:
        # Let the HTTP response leave before disconnecting the setup AP.
        time.sleep(2)
        nm("connection", "load", str(path))
        nm("--wait", "40", "connection", "up", name, "ifname", IFACE, timeout=50)
        if not status()["ip_address"]:
            raise RuntimeError("No address received")
        nm("connection", "modify", name, "connection.autoconnect", "yes")
        # The new profile remains available after reboot.
    except Exception:
        nm("connection", "delete", name, check=False)
        path.unlink(missing_ok=True)
        ap()
        raise


def watch():
    timeout = int(os.getenv("VIJU_RECOVERY_TIMEOUT", "90"))
    offline_since = time.monotonic()
    while True:
        try:
            state = status()
            if state["connected"]:
                offline_since = time.monotonic()
            elif state["setup_ap_active"]:
                offline_since = time.monotonic()
            elif not state["setup_ap_active"] and time.monotonic() - offline_since >= timeout:
                ap()
        except Exception as exc:
            print(f"Network watchdog: {type(exc).__name__}: {exc}", file=sys.stderr, flush=True)
        time.sleep(15)


if __name__ == "__main__":
    if os.geteuid() != 0 or len(sys.argv) != 2 or sys.argv[1] not in ("status", "connect", "watch", "ap"):
        sys.exit(2)
    try:
        action = sys.argv[1]
        if action == "status":
            print(json.dumps(status()))
        elif action == "connect":
            connect()
        elif action == "watch":
            watch()
        else:
            ap()
    except Exception as exc:
        print(f"Network action failed: {type(exc).__name__}: {exc}", file=sys.stderr)
        sys.exit(1)
